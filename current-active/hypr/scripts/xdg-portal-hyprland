#!/bin/bash
# Nuke all existing portal processes
killall -9 xdg-desktop-portal-hyprland xdg-desktop-portal-gtk xdg-desktop-portal-kde xdg-desktop-portal 2>/dev/null

sleep 1

# Ensure environment is synced to dbus/systemd
dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP=Hyprland
systemctl --user import-environment WAYLAND_DISPLAY XDG_CURRENT_DESKTOP

# Start the correct portal for Hyprland
/usr/lib/xdg-desktop-portal-hyprland &
sleep 2

# Start the general portal
/usr/lib/xdg-desktop-portal &
sleep 1

# Start GTK portal for file pickers etc.
/usr/lib/xdg-desktop-portal-gtk &
